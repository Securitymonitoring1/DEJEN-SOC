{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityEvent",
  "type": "object",
  "required": ["event_id", "timestamp", "agent_id", "host", "event_type", "message", "severity"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time"},
    "agent_id": {"type": "string"},
    "host": {"type": "string"},
    "event_type": {"type": "string", "description": "e.g. authentication_failed, authentication_success, process_start, file_modified, port_scan_detected"},
    "username": {"type": ["string", "null"]},
    "source_ip": {"type": ["string", "null"]},
    "dest_ip": {"type": ["string", "null"]},
    "dest_port": {"type": ["integer", "null"]},
    "process_name": {"type": ["string", "null"]},
    "file_path": {"type": ["string", "null"]},
    "file_hash": {"type": ["string", "null"]},
    "message": {"type": "string"},
    "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "raw": {"type": ["object", "null"], "description": "original unparsed payload, kept for debugging"}
  }
}
