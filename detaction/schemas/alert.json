{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityAlert",
  "type": "object",
  "required": ["alert_id", "rule_id", "rule_name", "severity", "created_at", "source_ip", "host", "description", "status"],
  "properties": {
    "alert_id": {"type": "string", "format": "uuid"},
    "rule_id": {"type": "string", "description": "e.g. brute_force, port_scan, malware, fim_violation"},
    "rule_name": {"type": "string"},
    "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_ip": {"type": ["string", "null"]},
    "host": {"type": ["string", "null"]},
    "username": {"type": ["string", "null"]},
    "mitre_technique": {"type": ["string", "null"], "description": "e.g. T1110 Brute Force"},
    "description": {"type": "string"},
    "related_event_ids": {"type": "array", "items": {"type": "string"}},
    "reputation": {
      "type": ["object", "null"],
      "description": "threat intel enrichment attached before alert creation",
      "properties": {
        "ip_score": {"type": ["number", "null"]},
        "is_known_malicious": {"type": ["boolean", "null"]},
        "source": {"type": ["string", "null"]}
      }
    },
    "status": {"type": "string", "enum": ["OPEN", "ACKNOWLEDGED", "RESOLVED", "FALSE_POSITIVE"]}
  }
}
