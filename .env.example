# Redpanda/Kafka delivery
REDPANDA_BROKERS=localhost:9092
REDPANDA_TOPIC=dejen-security-events
REDPANDA_TIMEOUT_SECONDS=10
REDPANDA_RETRIES=3
REDPANDA_RETRY_BACKOFF_SECONDS=0.25
REDPANDA_SECURITY_PROTOCOL=PLAINTEXT
REDPANDA_SASL_MECHANISM=
REDPANDA_SASL_USERNAME=
REDPANDA_SASL_PASSWORD=
REDPANDA_SSL_CAFILE=
REDPANDA_SSL_CERTFILE=
REDPANDA_SSL_KEYFILE=

# Shared collector identity
COLLECTOR_AGENT_ID=dejen-collector-001
COLLECTOR_HOST=

# Syslog receiver; keep loopback unless protected by a firewall
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=5514
SYSLOG_PROTOCOL=udp
SYSLOG_MAX_MESSAGE_BYTES=65536

# Linux FIM
FIM_ENABLED=true
FIM_PATHS=/etc
FIM_BASELINE_PATH=./data/fim_baseline.json
FIM_SCAN_INTERVAL_SECONDS=5
FIM_EXCLUDE_PATTERNS=*.tmp,*.swp,__pycache__

# Windows event collector
WINDOWS_EVENT_COLLECTION_INTERVAL=10
WINDOWS_EVENT_IDS=4624,4625,4720,4726,4728,4729,4732,4733

# Standalone Linux SSH authentication-log agent
DEJEN_AGENT_ID=linux-agent-001
DEJEN_HOST=
DEJEN_AUTH_LOG=/var/log/auth.log
DEJEN_API_URL=http://127.0.0.1:8000
DEJEN_API_TOKEN=
DEJEN_POLL_INTERVAL=5